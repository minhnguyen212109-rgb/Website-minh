
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nguyễn Xuân Bảo Minh | Portfolio</title>

<meta name="description" content="Website cá nhân của Nguyễn Xuân Bảo Minh - Photography, Running and Badminton.">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #101114;
    color: #f5f5f5;
    font-family: Arial, sans-serif;
    line-height: 1.7;
}

a {
    color: inherit;
    text-decoration: none;
}

header {
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #292a30;
    position: sticky;
    top: 0;
    background: rgba(16,17,20,0.95);
    z-index: 10;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 3px;
}

.logo span {
    color: #e6a36c;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: #aaa;
    font-size: 14px;
}

nav a:hover {
    color: #e6a36c;
}

.hero {
    min-height: 85vh;
    padding: 90px 10%;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.hero .small {
    color: #e6a36c;
    letter-spacing: 4px;
    font-size: 13px;
}

.hero h1 {
    font-size: clamp(42px, 9vw, 85px);
    line-height: 1.12;
    margin: 25px 0;
}

.hero h1 span {
    color: #e6a36c;
}

.hero p {
    color: #aaa;
    max-width: 550px;
}

.btn {
    display: inline-block;
    margin-top: 30px;
    padding: 12px 25px;
    border: 1px solid #e6a36c;
    color: #e6a36c;
    border-radius: 5px;
    width: fit-content;
    transition: 0.3s;
}

.btn:hover {
    background: #e6a36c;
    color: #101114;
}

section {
    padding: 85px 10%;
}

.section-label {
    color: #e6a36c;
    letter-spacing: 3px;
    font-size: 12px;
}

h2 {
    font-size: 35px;
    margin: 12px 0 30px;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 45px;
    align-items: center;
}

.about-content img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 12px;
}

.about-text p {
    color: #aaa;
    margin-bottom: 15px;
}

.hobbies {
    background: #17181d;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.card {
    background: #202127;
    border-radius: 12px;
    overflow: hidden;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

.card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
}

.card-content {
    padding: 20px;
}

.card h3 {
    margin-bottom: 8px;
}

.card p {
    color: #aaa;
    font-size: 14px;
}

.video-box {
    background: #202127;
    padding: 15px;
    border-radius: 12px;
}

video {
    width: 100%;
    border-radius: 8px;
    display: block;
}

.contact {
    background: #17181d;
    text-align: center;
}

.contact p {
    color: #aaa;
}

footer {
    text-align: center;
    padding: 30px 15px;
    color: #777;
    border-top: 1px solid #292a30;
    font-size: 13px;
}

@media (max-width: 650px) {
    header {
        padding: 15px 5%;
    }

    nav {
        gap: 12px;
    }

    nav a {
        font-size: 11px;
    }

    .hero {
        min-height: 75vh;
        padding: 70px 7%;
    }

    section {
        padding: 65px 7%;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    h2 {
        font-size: 29px;
    }
}
